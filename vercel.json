{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @freelanceflow/web run build && pnpm build:api",
  "outputDirectory": "artifacts/freelanceflow/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ]
}
